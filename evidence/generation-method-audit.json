  "recordedAt": "2026-11-10T21:57:37.045Z",
  "question": "Why did Runway clips in this repo look worse than clips made in the old lab on 2026-11-10 06:30–12:00 CET?",
  "answer": "The provider, key, model (wan3), ratio and request fields were identical. The method differed: the old lab ordered one action per clip between two real video frames; this repo ordered a whole deal-and-return in one 12 s clip whose last image was the start pose with a painted card.",
  "basis": {
    "verified": "Archived plans, receipts, start/end images and decoded frames read on 2026-11-10; batch results below reviewed frame by frame.",
    "inferred": "That clip structure and end-image meaning are the cause. Sampling variance is real: byte-identical inputs gave an edge passage once and a colour morph once."
  },
  "methodDifferences": [
    {
      "aspect": "Shot structure",
      "oldLab": "Entry 2 s, deal 4 s, return 2 s, continuation 3 s",
      "thisRepoBefore": "Take, turn, land, return and hold in one 12 s clip"
    },
    {
      "aspect": "First image",
      "oldLab": "Real decoded frame, thumb and index pinch on the shoe card; only card pixels recoloured",
      "thisRepoBefore": "Image-generated READY2, fingers flat on the card"
    },
    {
      "aspect": "Last image",
      "oldLab": "Real release frame with the hand at the card",
      "thisRepoBefore": "Start pose plus a painted blue quad"
    },
    {
      "aspect": "Chaining",
      "oldLab": "Returns start from an exact decoded frame of the deal",
      "thisRepoBefore": "None"
    },
    {
      "aspect": "Volume",
      "oldLab": "62 wan3 jobs for the turn bank, roughly one third rejected",
      "thisRepoBefore": "One job per idea, never re-ordered"
    },
    {
      "aspect": "What was watched",
      "oldLab": "Cut at release, keyed and composited",
      "thisRepoBefore": "Raw output"
    }
  ],
