{
  "autoCompactWindow": 300000,
  "skillOverrides": {
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:xlsx": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:docs": "name-only",
    "anthropic-skills:google-workspace": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:deep-research": "name-only",
    "anthropic-skills:skill-creator": "name-only"
  },
  "permissions": {
    "deny": [
      "Read(**/*.glb)",
      "Read(**/*.gltf)",
      "Read(**/*.bin)",
      "Read(**/*.fbx)",
      "Read(**/*.obj)",
      "Read(**/*.blend)",
      "Read(**/*.usdz)",
      "Read(**/*.onnx)",
      "Read(**/*.task)",
      "Read(**/*.safetensors)",
      "Read(**/*.hdr)",
      "Read(**/*.exr)",
      "Read(**/*.mp4)",
      "Read(**/*.mov)",
      "Read(**/*.webm)",
      "Read(**/*.wav)",
      "Read(**/*.mp3)",
      "Read(**/*.zip)",
      "Read(**/package-lock.json)",
      "Read(**/node_modules/**)",
      "Read(materials/kortmaterial.js)",
      "Read(materials/markermaterial.js)",
      "Read(materials/source/references/card-materials/vendor/three.module.js)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-guard.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
