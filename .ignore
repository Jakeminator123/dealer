# ripgrep (agents' rg, Claude Code's Grep/Glob) and VS Code/Cursor's search panel read this file before .gitignore.
# assets/ is ignored by Git; its small text (receipts, proof descriptions, generation records, prompts: about 6 MB)
# should be searchable, its media (about 9 GB) not. So: bring the folder back, hide all in it, bring back only text.
!/assets/
/assets/**
!/assets/**/
!/assets/**/*.json
!/assets/**/*.txt
!/assets/**/*.md

# Library code, not the project's own: three.js as brought in with the card material study, and the two built pages of
# that study (three.js plus about 300 lines of ours each). 163 000 lines that no search should wade through.
/materials/kortmaterial.js
/materials/markermaterial.js
/materials/source/references/card-materials/vendor/three.module.js
