# Media, renders and run data stay outside Git (AGENTS.md); media has a role in data/media-roles.json instead
assets/
output/
.runtime/

# Secrets and private material: never in Git
.env*
private/
*.pem
.vercel/

# Dependencies and build output (studio/.gitignore covers studio/.next/ and studio/out/)
node_modules/
*.tsbuildinfo
# The Python environment and model files of tools/python/ (its README says how to make them)
tools/python/.venv/
tools/python/models/
__pycache__/
*.log

# Binary material outside the source repo wherever it lands: the types tools/publication-check.ts stops at push
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.wav
*.mp3
*.zip
*.7z
*.rar
*.png
*.jpg
*.jpeg
*.webp
*.avif
*.gif
*.glb
*.hdr
*.exr
*.pdf
*.gz

# The checklist between Jakob and the main agent: a working paper, rewritten many times a day
CHECKLISTA.md

# Requests from the online copy, fetched by tools/onskemal.ts for Jakob to read
ONSKEMAL.md
